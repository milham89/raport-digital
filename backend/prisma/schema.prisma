generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  nip          String?  @unique
  role         String   @default("teacher") // "admin" | "teacher" | "homeroom" | "principal"
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  homeroomClasses    Class[]             @relation("HomeroomTeacher")
  teacherAssignments TeacherAssignment[]
  grades             Grade[]

  @@map("users")
}

model AcademicYear {
  id        String   @id @default(uuid())
  yearName  String   @map("year_name")
  semester  String   // "ganjil" | "genap"
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  classes            Class[]
  teacherAssignments TeacherAssignment[]
  grades             Grade[]
  attendances        StudentAttendanceRemark[]

  @@unique([yearName, semester])
  @@map("academic_years")
}

model Class {
  id                String       @id @default(uuid())
  className         String       @map("class_name")
  academicYearId    String       @map("academic_year_id")
  academicYear      AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  homeroomTeacherId String?      @map("homeroom_teacher_id")
  homeroomTeacher   User?        @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  students           Student[]
  teacherAssignments TeacherAssignment[]
  grades             Grade[]
  attendances        StudentAttendanceRemark[]

  @@unique([className, academicYearId])
  @@map("classes")
}

model Student {
  id        String   @id @default(uuid())
  nis       String   @unique
  nisn      String?  @unique
  fullName  String   @map("full_name")
  gender    String   // "L" | "P"
  classId   String?  @map("class_id")
  class     Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  grades      Grade[]
  attendances StudentAttendanceRemark[]

  @@map("students")
}

model Subject {

  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  kkm       Float    @default(75.0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teacherAssignments TeacherAssignment[]
  grades             Grade[]

  @@map("subjects")
}

model TeacherAssignment {
  id             String       @id @default(uuid())
  teacherId      String       @map("teacher_id")
  teacher        User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId      String       @map("subject_id")
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId        String       @map("class_id")
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYearId String       @map("academic_year_id")
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([teacherId, subjectId, classId, academicYearId])
  @@map("teacher_assignments")
}

model Grade {
  id              String       @id @default(uuid())
  studentId       String       @map("student_id")
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId       String       @map("subject_id")
  subject         Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId       String       @map("teacher_id")
  teacher         User         @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  classId         String       @map("class_id")
  class           Class        @relation(fields: [classId], references: [id], onDelete: Restrict)
  academicYearId  String       @map("academic_year_id")
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  assignmentScore Float        @default(0.0) @map("assignment_score")
  midScore        Float        @default(0.0) @map("mid_score")
  finalScore      Float        @default(0.0) @map("final_score")
  finalGrade      Float        @default(0.0) @map("final_grade")
  predicate       String       @default("D")
  feedback        String?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([studentId, subjectId, academicYearId])
  @@map("grades")
}

model StudentAttendanceRemark {
  id                   String       @id @default(uuid())
  studentId            String       @map("student_id")
  student              Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId              String       @map("class_id")
  class                Class        @relation(fields: [classId], references: [id], onDelete: Restrict)
  academicYearId       String       @map("academic_year_id")
  academicYear         AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  sickDays             Int          @default(0) @map("sick_days")
  permissionDays       Int          @default(0) @map("permission_days")
  unexcusedDays        Int          @default(0) @map("unexcused_days")
  extracurricularNotes String?      @default("[]") @map("extracurricular_notes")
  homeroomNote         String?      @map("homeroom_note")
  status               String       @default("draft") // "draft" | "finalized" | "approved"
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  @@unique([studentId, academicYearId])
  @@map("student_attendances_remarks")
}
